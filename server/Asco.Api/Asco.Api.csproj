<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Asco.Api</RootNamespace>
    <!-- ASCO reuses C-ERP's accounting core unmodified. Point this at another checkout with
         `dotnet build -p:CErpSrc=...` (or the CERP_SRC env var) — see server/README.md. -->
    <CErpSrc Condition="'$(CErpSrc)' == '' And '$(CERP_SRC)' != ''">$(CERP_SRC)</CErpSrc>
    <!-- Local dev: the live C-ERP checkout. Anywhere else (Render, CI): the snapshot in vendor/c-erp,
         refreshed with deploy/refresh-cerp-vendor.ps1. -->
    <CErpSrc Condition="'$(CErpSrc)' == '' And Exists('D:\C-ERP\C_ERP-main\src')">D:\C-ERP\C_ERP-main\src</CErpSrc>
    <CErpSrc Condition="'$(CErpSrc)' == ''">$(MSBuildThisFileDirectory)..\..\vendor\c-erp\src</CErpSrc>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CErpSrc)\AegisErp.Infrastructure\AegisErp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Asco.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.50.0" />
  </ItemGroup>

</Project>
